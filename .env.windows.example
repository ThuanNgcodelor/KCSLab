# Mẫu .env cho Windows server (Laragon). Sao chép thành .env ở thư mục gốc dự án rồi điền giá trị thật.
SPRING_PROFILES_ACTIVE=mysql

# Tài khoản Admin đầu tiên (chỉ tạo khi database chưa có Admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Địa chỉ người dùng mở trang (thay 192.168.1.50 bằng IP máy server). Nhiều địa chỉ ngăn bằng dấu phẩy.
FRONTEND_ORIGIN=http://localhost:5173,http://192.168.1.50:5173
SECURE_COOKIE=false
# Trang tra cứu in trong mã QR của phiếu kết quả
PUBLIC_LOOKUP_URL=http://192.168.1.50:5173/tracuu/
# Apache của Laragon chuyển tiếp IP khách qua header này (dùng cho giới hạn tra cứu)
PUBLIC_CLIENT_IP_HEADER=X-Forwarded-For

# MySQL của Laragon
DB_URL=jdbc:mysql://127.0.0.1:3306/cfc_lab?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=cfc
DB_PASSWORD=

# Redis của Laragon (để trống mật khẩu nếu Redis chưa đặt requirepass)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Không bắt buộc: đường dẫn LibreOffice nếu cài ở chỗ khác (mặc định tự tìm trong Program Files)
# REPORT_OFFICE_COMMAND=C:\Program Files\LibreOffice\program\soffice.com
