# Backend development
SPRING_PROFILES_ACTIVE=mysql
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-development-password
JWT_SECRET=change-this-secret-to-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.132:5173
# Frontend mặc định gọi /api cùng origin; Vite dev proxy chuyển tiếp sang backend :8080.
SECURE_COOKIE=false

# MySQL profile (only when SPRING_PROFILES_ACTIVE=mysql)
DB_URL="jdbc:mysql://localhost:3306/cfc_lab?useSSL=false&serverTimezone=UTC"
DB_USERNAME=cfc
DB_PASSWORD=change-this-database-password

# Redis refresh sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Public result lookup (QR on KQKN PDF = PUBLIC_LOOKUP_URL + ?code=...).
# LAN now: Vite serves source/public/tracuu at /tracuu/. Later: switch to the domain, e.g. https://tracuu.example.vn/tracuu/
# Only PDFs published after the change get the new address (published PDFs are immutable).
PUBLIC_LOOKUP_URL=http://192.168.1.132:5173/tracuu/
# Real client IP for public rate limits: X-Forwarded-For behind the Vite proxy/nginx, CF-Connecting-IP behind Cloudflare.
PUBLIC_CLIENT_IP_HEADER=X-Forwarded-For
