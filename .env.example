# Backend development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-development-password
JWT_SECRET=change-this-secret-to-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173,http://192.168.1.100:5173
# Frontend mặc định gọi /api cùng origin; Vite dev proxy chuyển tiếp sang backend :8080.
SECURE_COOKIE=false

# MySQL profile (only when SPRING_PROFILES_ACTIVE=mysql)
DB_URL=jdbc:mysql://localhost:3306/cfc_lab?useSSL=false&serverTimezone=UTC
DB_USERNAME=cfc
DB_PASSWORD=change-this-database-password
